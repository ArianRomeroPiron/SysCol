{
  "version": 1,
  "projects": {
    "syscol": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["@fontsource-variable/figtree/wght.css", "src/styles.css"],
            "outputPath": "dist/syscol"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "demo": {
              "outputHashing": "all",
              "outputPath": "dist/syscol-demo",
              "fileReplacements": [
                {
                  "replace": "src/app/transport.ts",
                  "with": "src/app/transport.demo.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "syscol:build" },
          "configurations": {
            "demo": { "buildTarget": "syscol:build:demo" }
          }
        }
      }
    }
  }
}
